{
    "version": 2,
    "discoverIgnore": [
        {"plugin": "Freebox_OS", "reason": "Le plugin découvre lui-même les appareils du réseau et met leur ip à jour"}
    ],
    "rules": [
        {"id": "Abeille", "plugin": "Abeille", "source": "pluginConfig", "key": "IpWifiZigate{n}", "replace": "ip", "repeat": {"from": 1, "toKey": "zigateNb"}, "name": "Zigate{n}", "conditions": [{"key": "AbeilleType{n}", "op": "==", "value": "WIFI"}, {"key": "@value", "op": "notempty"}], "daemon": true, "legacy": "{plugin}|{key}"},
        {"id": "AndroidTV", "plugin": "AndroidTV", "source": "eqLogic", "key": "ip_address", "detailKey": "type_connection", "conditions": [{"key": "type_connection", "op": "!=", "value": "USB"}], "legacy": "{plugin}|{eqId}"},
        {"id": "Creality_Box", "plugin": "Creality_Box", "source": "pluginConfig", "key": "ip", "replace": "ip", "name": "Creality Box", "daemon": true, "legacy": "{plugin}|config"},
        {"id": "DaikinOnlineCtrl", "plugin": "DaikinOnlineCtrl", "source": "eqLogic", "key": "addIPCtrl", "conditions": [{"key": "@value", "op": "notempty"}], "legacy": "{plugin}|{eqId}"},
        {"id": "JPI", "plugin": "JPI", "source": "eqLogic", "key": "jpiIp", "legacy": "{plugin}|{eqId}"},
        {"id": "Jailbreak", "plugin": "Jailbreak", "source": "eqLogic", "key": "addressip", "detailKey": "Modele", "legacy": "{plugin}|{eqId}"},
        {"id": "JeeMySensors", "plugin": "JeeMySensors", "source": "eqLogic", "key": "ip_gw", "conditions": [{"key": "type_gw", "op": "==", "value": "lan"}], "legacy": "{plugin}|{eqId}"},
        {"id": "JeeOrangeTv", "plugin": "JeeOrangeTv", "source": "eqLogic", "key": "box_ip", "legacy": "{plugin}|{eqId}"},
        {"id": "Monitoring", "plugin": "Monitoring", "source": "eqLogic", "key": "addressip", "detailKey": "maitreesclave", "conditions": [{"key": "maitreesclave", "op": "==", "value": "deporte"}], "legacy": "{plugin}|{eqId}"},
        {"id": "Nut_free", "plugin": "Nut_free", "source": "eqLogic", "key": "addressip", "legacy": "{plugin}|{eqId}"},
        {"id": "Palazzetti", "plugin": "Palazzetti", "source": "eqLogic", "key": "addressip", "conditions": [{"key": "@value", "op": "notempty"}], "legacy": "{plugin}|{eqId}"},
        {"id": "YamahaMusiccast", "plugin": "YamahaMusiccast", "source": "eqLogic", "key": "ip", "conditions": [{"key": "@value", "op": "notempty"}], "legacy": "{plugin}|{eqId}"},
        {"id": "blea", "plugin": "blea", "source": "php", "class": "blea", "description": "Antennes distantes (blea_remote) : relance de l'antenne après changement"},
        {"id": "broadlink", "plugin": "broadlink", "source": "eqLogic", "key": "ip", "detailKey": "device", "legacy": "{plugin}|{eqId}"},
        {"id": "camera", "plugin": "camera", "source": "php", "class": "camera", "description": "Met aussi à jour l'URL du flux si elle contient l'ancienne ip"},
        {"id": "clage", "plugin": "clage", "source": "pluginConfig", "key": "ip", "replace": "ip", "name": "Clage Server", "legacy": "{plugin}|config"},
        {"id": "cloudsyncpro", "plugin": "cloudsyncpro", "source": "eqLogic", "key": "param1", "detailKey": "type", "conditions": [{"key": "type", "op": "in", "value": "ftp,sftp"}], "legacy": "{plugin}|{eqId}"},
        {"id": "core.samba_ip", "plugin": "core", "source": "pluginConfig", "key": "samba::backup::ip", "replace": "ip", "name": "Samba Backup IP", "conditions": [{"key": "@value", "op": "notempty"}], "legacy": "core|updatetab|samba::backup::ip"},
        {"id": "core.samba_share", "plugin": "core", "source": "pluginConfig", "key": "samba::backup::share", "replace": "ip", "name": "Samba Backup Partage", "conditions": [{"key": "@value", "op": "notempty"}], "legacy": "core|updatetab|samba::backup::share"},
        {"id": "core.internalAddr", "plugin": "core", "source": "pluginConfig", "key": "internalAddr", "replace": "ip", "name": "Accès interne", "conditions": [{"key": "@value", "op": "notempty"}], "legacy": "core|networktab|internalAddr"},
        {"id": "core.cmdPushUrl", "plugin": "core", "source": "pluginConfig", "key": "cmdPushUrl", "replace": "ip", "name": "Push", "conditions": [{"key": "@value", "op": "notempty"}], "legacy": "core|commandtab|cmdPushUrl"},
        {"id": "espeasy", "plugin": "espeasy", "source": "eqLogic", "key": "ip", "detailKey": "icone", "legacy": "{plugin}|{eqId}"},
        {"id": "ewejee", "plugin": "ewejee", "source": "eqLogic", "key": "ip", "conditions": [{"key": "@value", "op": "notempty"}], "legacy": "{plugin}|{eqId}"},
        {"id": "fullyKiosK", "plugin": "fullyKiosK", "source": "eqLogic", "key": "addressip", "legacy": "{plugin}|{eqId}"},
        {"id": "globalcache", "plugin": "globalcache", "source": "logicalId", "key": "logicalId", "detailKey": "type", "legacy": "{plugin}|{eqId}"},
        {"id": "googlecast", "plugin": "googlecast", "source": "eqLogic", "key": "ip", "detailKey": "friendly_name", "legacy": "{plugin}|{eqId}"},
        {"id": "harmonyhub", "plugin": "harmonyhub", "source": "pluginConfig", "key": "ip", "replace": "ip", "name": "Harmony Hub", "legacy": "{plugin}|config"},
        {"id": "hdsentinel", "plugin": "hdsentinel", "source": "eqLogic", "key": "addressip", "conditions": [{"key": "@value", "op": "notempty"}], "legacy": "{plugin}|{eqId}"},
        {"id": "homepTalk", "plugin": "homepTalk", "source": "php", "class": "homepTalk", "description": "Met aussi à jour les membres des groupes"},
        {"id": "huawei4g", "plugin": "huawei4g", "source": "eqLogic", "key": "ip", "legacy": "{plugin}|{eqId}"},
        {"id": "influxdb", "plugin": "influxdb", "source": "eqLogic", "key": "serverIP", "conditions": [{"key": "@value", "op": "notempty"}], "legacy": "{plugin}|{eqId}"},
        {"id": "iotawatt", "plugin": "iotawatt", "source": "eqLogic", "key": "ip", "conditions": [{"key": "@value", "op": "notempty"}], "legacy": "{plugin}|{eqId}"},
        {"id": "jMQTT", "plugin": "jMQTT", "source": "eqLogic", "key": "mqttAddress", "conditions": [{"key": "@value", "op": "notempty"}], "legacy": "{plugin}|{eqId}"},
        {"id": "kodi", "plugin": "kodi", "source": "eqLogic", "key": "addr", "legacy": "{plugin}|{eqId}"},
        {"id": "kroomba", "plugin": "kroomba", "source": "eqLogic", "key": "roomba_ip", "conditions": [{"key": "@value", "op": "notempty"}], "legacy": "{plugin}|{eqId}"},
        {"id": "mirobot", "plugin": "mirobot", "source": "eqLogic", "key": "ip", "detailKey": "type", "legacy": "{plugin}|{eqId}"},
        {"id": "mqtt2", "plugin": "mqtt2", "source": "pluginConfig", "key": "remote::ip", "replace": "ip", "name": "MQTT Manager", "daemon": true, "legacy": "{plugin}|config"},
        {"id": "networks.ip", "plugin": "networks", "source": "eqLogic", "key": "ip", "detail": "ip", "legacy": "{plugin}|{eqId}|{key}"},
        {"id": "networks.broadcastIP", "plugin": "networks", "source": "eqLogic", "key": "broadcastIP", "detail": "ip WoL", "legacy": "{plugin}|{eqId}|{key}"},
        {"id": "nut", "plugin": "nut", "source": "eqLogic", "key": "adresse_nut", "conditions": [{"key": "@value", "op": "notin", "value": "127.0.0.1,localhost"}], "legacy": "{plugin}|{eqId}"},
        {"id": "octoprint", "plugin": "octoprint", "source": "eqLogic", "key": "servip", "conditions": [{"key": "@value", "op": "notempty"}], "legacy": "{plugin}|{eqId}"},
        {"id": "onkyo", "plugin": "onkyo", "source": "eqLogic", "key": "onkyo_ip", "daemon": true, "legacy": "{plugin}|{eqId}"},
        {"id": "openWrt", "plugin": "openWrt", "source": "pluginConfig", "key": "addr", "replace": "ip", "name": "Routeur openWrt", "legacy": "{plugin}|config"},
        {"id": "pjlink", "plugin": "pjlink", "source": "eqLogic", "key": "host", "detailKey": "pjlink_model", "legacy": "{plugin}|{eqId}"},
        {"id": "printerStatus", "plugin": "printerStatus", "source": "eqLogic", "key": "adresse_ip", "conditions": [{"key": "@value", "op": "notempty"}], "legacy": "{plugin}|{eqId}"},
        {"id": "proxmox", "plugin": "proxmox", "source": "pluginConfig", "key": "IP", "replace": "ip", "name": "Proxmox", "legacy": "{plugin}|config"},
        {"id": "script", "plugin": "script", "source": "cmd", "key": "request", "replace": "ip", "legacy": "{plugin}|{eqId}|{cmdId}"},
        {"id": "shelly", "plugin": "shelly", "source": "eqLogic", "key": "addr", "conditions": [{"key": "@value", "op": "notempty"}], "legacy": "{plugin}|{eqId}"},
        {"id": "sonoffdiy", "plugin": "sonoffdiy", "source": "eqLogic", "key": "adresse_ip", "detailKey": "device", "daemon": true, "legacy": "{plugin}|{eqId}"},
        {"id": "sonybravia", "plugin": "sonybravia", "source": "eqLogic", "key": "ipadress", "conditions": [{"key": "@value", "op": "notempty"}], "legacy": "{plugin}|{eqId}"},
        {"id": "sshcommander", "plugin": "sshcommander", "source": "eqLogic", "key": "sshhost", "legacy": "{plugin}|{eqId}"},
        {"id": "sshmanager", "plugin": "sshmanager", "source": "php", "class": "sshmanager", "description": "Hôte des équipements et ip présentes dans les commandes SSH"},
        {"id": "surveillanceStation", "plugin": "surveillanceStation", "source": "pluginConfig", "key": "ip", "replace": "ip", "name": "SurveillanceStation", "conditions": [{"key": "@value", "op": "notempty"}], "legacy": "{plugin}|{key}"},
        {"id": "synologyapi", "plugin": "synologyapi", "source": "pluginConfig", "key": "Syno{n}_server", "replace": "ip", "repeat": {"from": 1, "to": 3}, "name": "Syno{n}", "nameKey": "Syno{n}_name", "conditions": [{"key": "@value", "op": "notempty"}], "legacy": "{plugin}|{key}"},
        {"id": "tendaac", "plugin": "tendaac", "source": "eqLogic", "key": "ip", "detailKey": "type", "conditions": [{"key": "type", "op": "!=", "value": "cli"}], "legacy": "{plugin}|{eqId}"},
        {"id": "tvByOrange", "plugin": "tvByOrange", "source": "eqLogic", "key": "ip", "legacy": "{plugin}|{eqId}"},
        {"id": "tvremote", "plugin": "tvremote", "source": "eqLogic", "key": "hostAddr", "legacy": "{plugin}|{eqId}"},
        {"id": "tydom", "plugin": "tydom", "source": "pluginConfig", "key": "host", "replace": "ip", "name": "Tydom", "legacy": "{plugin}|config"},
        {"id": "vigipool", "plugin": "vigipool", "source": "eqLogic", "key": "param1", "conditions": [{"key": "@value", "op": "notempty"}], "legacy": "{plugin}|{eqId}"},
        {"id": "vmware", "plugin": "vmware", "source": "eqLogic", "key": "ipAddress", "detailKey": "type", "conditions": [{"key": "type", "op": "==", "value": "ESXi"}], "legacy": "{plugin}|{eqId}"},
        {"id": "webosTv", "plugin": "webosTv", "source": "eqLogic", "key": "addr", "legacy": "{plugin}|{eqId}"},
        {"id": "wifilightV2", "plugin": "wifilightV2", "source": "eqLogic", "key": "addr", "conditions": [{"key": "@value", "op": "notempty"}], "legacy": "{plugin}|{eqId}"},
        {"id": "xiaomihome", "plugin": "xiaomihome", "source": "eqLogic", "key": "ipwifi", "detailKey": "type", "conditions": [{"key": "type", "op": "in", "value": "yeelight,wifi"}], "legacy": "{plugin}|{eqId}"},
        {"id": "zigate", "plugin": "zigate", "source": "pluginConfig", "key": "host", "replace": "ip", "name": "ZiGate Wifi", "daemon": true, "legacy": "{plugin}|config"},
        {"id": "zigbee", "plugin": "zigbee", "source": "pluginConfig", "key": "wifizigate_{n}", "replace": "ip", "repeat": {"from": 1, "to": 2}, "name": "ZiGate Wifi {n}", "detail": "Démon {n}", "conditions": [{"key": "port_{n}", "op": "==", "value": "wifizigate"}, {"key": "enable_deamon_{n}", "op": "==", "value": "1"}], "daemon": true, "legacy": "{plugin}|{key}"}
    ]
}
